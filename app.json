{
  "expo": {
    "name": "Tennis Serve Coach",
    "slug": "tennis-serve-coach",
    "version": "1.0.0",
    "scheme": "tennis-serve-coach",
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "expo-localization",
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Tennis Serve Coach to access your camera to record your serve.",
          "microphonePermission": "Allow Tennis Serve Coach to access your microphone to record audio with your videos.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "experiments": {
      "reactCanary": true,
      "reactCompiler": true,
      "buildCacheProvider": {
        "plugin": "expo-build-disk-cache"
      },
      "tsconfigPaths": true,
      "typedRoutes": true
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tennisservecoach.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "This app needs camera access to record your tennis serve and provide real-time feedback on your form.",
        "NSMicrophoneUsageDescription": "This app needs microphone access to record audio with your serve videos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.tennisservecoach.app",
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "newArchEnabled": true,
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
